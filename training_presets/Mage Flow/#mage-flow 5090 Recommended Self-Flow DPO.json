{
    "base_model_name": "microsoft/Mage-Flow-Base",
    "model_type": "MAGE_FLOW",
    "training_method": "LORA",
    "output_model_format": "DIFFUSERS_LORA",
    "resolution": "1024",
    "batch_size": 1,
    "gradient_accumulation_steps": 2,
    "learning_rate": 3e-5,
    "learning_rate_scheduler": "CONSTANT",
    "learning_rate_warmup_steps": 200.0,
    "train_dtype": "BFLOAT_16",
    "output_dtype": "BFLOAT_16",
    "attention_mechanism": "SDP",
    "compile": false,
    "image_caching": true,
    "text_caching": true,
    "clear_cache_before_training": true,
    "prefetch_next_batch": false,
    "clip_grad_norm": 1.0,
    "transformer": {
        "train": true,
        "weight_dtype": "BFLOAT_16",
        "gradient_checkpointing": true,
        "activation_offloading": false,
        "offload_fraction": 0.0
    },
    "text_encoder": {
        "train": false,
        "weight_dtype": "BFLOAT_16",
        "gradient_checkpointing": false
    },
    "text_encoder_sequence_length": 512,
    "vae": {
        "weight_dtype": "FLOAT_32"
    },
    "lora_rank": 64,
    "lora_alpha": 1.0,
    "lora_weight_dtype": "FLOAT_32",
    "layer_filter": "attn,img_mlp,txt_mlp",
    "layer_filter_preset": "attn-mlp",
    "timestep_distribution": "UNIFORM",
    "timestep_shift": 6.0,
    "dynamic_timestep_shifting": false,
    "self_flow_enabled": true,
    "self_flow_mask_ratio": 0.25,
    "self_flow_rep_weight": 0.8,
    "self_flow_structural_enabled": true,
    "self_flow_structural_weight": 0.1,
    "self_flow_structural_tokens": 256,
    "self_flow_ema_decay": 0.9999,
    "self_flow_student_layer": -1,
    "self_flow_teacher_layer": -1,
    "self_flow_teacher_target_offload": false,
    "rlhf_enabled": true,
    "rlhf_mode": "DPO",
    "rlhf_dpo_objective": "LINEAR",
    "rlhf_dpo_beta": 100.0,
    "rlhf_dpo_linear_eta": 0.01,
    "rlhf_dpo_linear_ema_decay": 0.995,
    "rlhf_supervised_mix": 1.0,
    "rlhf_dpo_momentum_bypass": true,
    "rlhf_dpo_adaptive_beta": false,
    "rlhf_dpo_adaptive_dataset": false,
    "rlhf_dpo_hard_pair_curriculum": false,
    "rlhf_dpo_label_smoothing": 0.0,
    "rlhf_dpo_beta_gradient_decouple": false,
    "rlhf_dpo_chosen_reward_anchor": false,
    "rlhf_dpo_timestep_margin_logging": true
}
