{
    "__version": 12,
    "base_model_name": "OpenMOSS-Team/MOSS-Image-Base",
    "model_type": "MOSS_IMAGE",
    "training_method": "FINE_TUNE",
    "batch_size": 1,
    "gradient_accumulation_steps": 4,
    "resolution": "1024",
    "learning_rate": 0.000001,
    "train_dtype": "BFLOAT_16",
    "output_dtype": "BFLOAT_16",
    "output_model_format": "DIFFUSERS",
    "attention_mechanism": "SDP",
    "compile": false,
    "transformer": {
        "train": true,
        "weight_dtype": "FLOAT_32",
        "gradient_checkpointing": true,
        "offload_fraction": 0,
        "activation_offloading": false
    },
    "text_encoder": {
        "train": false,
        "weight_dtype": "BFLOAT_16",
        "offload_fraction": 0,
        "activation_offloading": false,
        "dropout_probability": 0
    },
    "vae": {
        "weight_dtype": "FLOAT_32"
    },
    "image_caching": true,
    "text_caching": true,
    "text_encoder_sequence_length": 512,
    "layer_filter": "",
    "layer_filter_preset": "full",
    "dropout_probability": 0,
    "timestep_distribution": "LOGIT_NORMAL",
    "noising_weight": 0.0,
    "noising_bias": 1.09,
    "timestep_shift": 1,
    "dynamic_timestep_shifting": false
}
